{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "terminal": false,
    "grouping": "none"
  },
  "animations": true,
  "prompt": {
    "paste": "compact"
  },
  "attention": {
    "sound": false
  },
  "terminal": {
    "copy": "select"
  },
  "tabs": {
    "indicators": "status",
    "layout": "horizontal",
    "scope": "cwd",
    "enabled": false
  }
}
