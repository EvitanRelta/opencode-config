{
    "$schema": "https://opencode.ai/config.json",
    "plugins": ["-@tarquinen/opencode-dcp@latest"],
    "lsp": false,
    "permissions": [
        { "action": "lsp", "resource": "*", "effect": "allow" }, // Requires OPENCODE_EXPERIMENTAL_LSP_TOOL=true
        { "action": "websearch", "resource": "*", "effect": "allow" }, // Requires OPENCODE_ENABLE_EXA=1
    ],
    "agents": {
        "title": { "model": "opencode-go/deepseek-v4-flash" },
        "build": { "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }] },
        "plan": { "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }] },
        "general": { "model": "openai/gpt-5.6-sol#medium" },
        "explore": { "model": "opencode-go/deepseek-v4-flash" },
    },
}
