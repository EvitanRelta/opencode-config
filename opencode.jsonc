{
    "$schema": "https://opencode.ai/config.json",
    "plugin": ["@tarquinen/opencode-dcp@latest"],
    "small_model": "opencode-go/mimo-v2.5",
    "lsp": false,
    "permission": {
        "lsp": "allow", // Requires OPENCODE_EXPERIMENTAL_LSP_TOOL=true
        "websearch": "allow", // Requires OPENCODE_ENABLE_EXA=1
    },
    "agent": {
        "build": { "permission": { "task": "deny" } },
        "plan": { "permission": { "task": "deny" } },
        "general": { "model": "opencode-go/glm-5.2" },
        "explore": { "model": "opencode-go/glm-5.2" },
    },
}
